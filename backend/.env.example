# Which storage implementation to use: "gcs" or "s3".
# Both satisfy the same StorageClient protocol; the routes are unaware of
# which one is active.
STORAGE_BACKEND=gcs

# --- Google Cloud Storage (STORAGE_BACKEND=gcs) ---
# Name of the bucket that holds stored weather files.
GCS_BUCKET=your-bucket-name

# --- S3-compatible storage (STORAGE_BACKEND=s3) ---
# Works with AWS S3 or any S3-compatible provider, e.g. Supabase Storage.
S3_BUCKET=your-bucket-name
# Leave empty for real AWS; set it for a non-AWS provider.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1

# Comma-separated origins allowed by CORS. Never "*".
ALLOWED_ORIGINS=http://localhost:5173

# --- Not read from this file ---
# Credentials are deliberately excluded: boto3 reads AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY from the real environment, and GCS uses Application
# Default Credentials. Set them in your host's secret store (Render env vars,
# Cloud Run --set-env-vars) or your shell — never in a file that could be
# committed.
#
# STORAGE_EMULATOR_HOST is the same: it only works as a real environment
# variable. pydantic-settings loads this file into Settings without exporting
# to os.environ, and the cloud SDKs read their own variables directly from the
# process environment, so putting it here has no effect.
