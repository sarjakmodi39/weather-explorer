# Which storage implementation to use: "gcs" or "s3".
# Both satisfy the same StorageClient protocol; the routes are unaware of
# which one is active.
STORAGE_BACKEND=gcs

# --- Google Cloud Storage (STORAGE_BACKEND=gcs) ---
# Name of the bucket that holds stored weather files.
GCS_BUCKET=your-bucket-name

# --- S3-compatible storage (STORAGE_BACKEND=s3) ---
# Works with AWS S3 or any S3-compatible provider, e.g. Supabase Storage.
S3_BUCKET=your-bucket-name
# Leave empty for real AWS; set it for a non-AWS provider.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1

# Comma-separated origins allowed by CORS. Never "*".
ALLOWED_ORIGINS=http://localhost:5173

# --- Credentials: deliberately not listed here ---
# boto3 reads AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, and GCS uses
# Application Default Credentials. Set them in your host's secret store
# (Render env vars, Cloud Run --set-env-vars) or your shell — never in a file
# that could be committed. app/config.py calls load_dotenv(), so anything in
# a local .env does reach the SDKs; that is a convenience for development, not
# an invitation to put real secrets in a file.

# --- Local development against a storage emulator ---
# STORAGE_EMULATOR_HOST=http://127.0.0.1:9023
#
# Use 127.0.0.1, not localhost. The emulator binds IPv4 only, and on Windows
# "localhost" resolves to ::1 (IPv6) first, so every request pays a failed
# IPv6 connection attempt before falling back. Measured: 2.06s per call via
# localhost versus 0.009s via 127.0.0.1 — a 230x difference that presents as
# the UI hanging on "Loading file...", when it is really name resolution.
