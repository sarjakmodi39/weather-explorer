# Base URL of the backend. No trailing slash.
#
# Vite inlines this at BUILD time, so changing it requires restarting the dev
# server (or rebuilding for production) — editing .env.local while `npm run dev`
# is already running has no effect.
#
# For local development prefer 127.0.0.1 over localhost. uvicorn binds IPv4
# only, and on Windows "localhost" resolves to ::1 (IPv6) first, so the browser
# pays a failed IPv6 connection on every API call before falling back. Measured
# at roughly 2s per request — enough that the city search sits on "Searching…"
# long enough to look broken.
VITE_API_BASE=http://127.0.0.1:8000
